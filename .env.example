# FastAPI runtime. Copy to .env for local connected-mode development.
ENVIRONMENT=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Atlas or another MongoDB deployment. Empty uses in-memory CRUD locally.
MONGODB_URI=
MONGODB_DATABASE=visit_jamaica

# Elastic self-managed Basic or Elastic Cloud. Empty uses catalogue search locally.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=visit-jamaica-content
ELASTICSEARCH_AUTO_INDEX=false
SEARCH_ADMIN_KEY=

# Optional Vercel AI Gateway. Disabled and missing credentials use deterministic planning.
AI_ENABLED=false
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_TIMEOUT_MS=4500
AI_MAX_DAILY_CALLS=100
AI_MAX_SESSION_CALLS_PER_HOUR=3
EVENT_MAX_SESSION_CALLS_PER_HOUR=30
