# Supabase browser configuration (publishable/anon value only; never service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Worker variables for connected mode. Set non-public values with `wrangler secret put`.
# Opt into the OpenNext development bridge only when using Cloudflare bindings locally.
CLOUDFLARE_DEV_BINDINGS=false
DEMO_MODE=true
AI_ENABLED=false
AI_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_TIMEOUT_MS=4500
AI_MAX_DAILY_CALLS=100
AI_MAX_SESSION_CALLS_PER_HOUR=3
EVENT_MAX_SESSION_CALLS_PER_HOUR=30
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
