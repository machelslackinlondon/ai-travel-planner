{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/app",
  "tags": ["type:app", "platform:python", "deployment:fly"],
  "implicitDependencies": ["catalog"],
  "targets": {
    "sync": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "env UV_CACHE_DIR=.cache/uv uv sync --project apps/api --dev"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "env UV_CACHE_DIR=.cache/uv uv run --no-sync --project apps/api uvicorn app.main:app --reload --reload-dir apps/api/app --host 127.0.0.1 --port 4000"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env UV_CACHE_DIR=.cache/uv uv run --no-sync --project apps/api python -m compileall -q apps/api/app"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env UV_CACHE_DIR=.cache/uv uv run --no-sync --project apps/api ruff check apps/api/app apps/api/tests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env UV_CACHE_DIR=.cache/uv uv run --no-sync --project apps/api mypy apps/api/app"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env UV_CACHE_DIR=.cache/uv uv run --no-sync --project apps/api pytest apps/api/tests"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker build --file apps/api/Dockerfile --tag visit-jamaica-api:local ."
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "fly deploy . --config apps/api/fly.toml --dockerfile apps/api/Dockerfile"
      }
    }
  }
}
