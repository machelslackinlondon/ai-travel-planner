{
  "name": "visit-jamaica-ai-trip-planner",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "nx run-many --target=dev --projects=api,web --parallel=2",
    "dev:web": "nx run web:dev",
    "dev:api": "nx run api:dev",
    "build": "nx run-many --target=build --projects=api,web",
    "typecheck": "nx run-many --target=typecheck --projects=api,web",
    "test": "nx run-many --target=test --projects=api,web",
    "test:e2e": "nx run web-e2e:e2e",
    "lint": "nx run-many --target=lint --projects=api,web,catalog",
    "seed": "nx run web:seed",
    "graph": "nx graph",
    "deploy:web": "nx run web:deploy",
    "deploy:api": "nx run api:deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "nx": "^22.0.0"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.3"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false,
    "nx@22.7.7": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
